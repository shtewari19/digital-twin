# Copy to .env and adjust as needed. Read by both docker-compose.yml
# (Postgres container credentials) and app/core/config.py (Settings).

APP_POSTGRES_USER=core_api
APP_POSTGRES_PASSWORD=dev_password
APP_POSTGRES_HOST=localhost
APP_POSTGRES_PORT=5432
APP_POSTGRES_DB=core_api

# Fixed identity the auth stub (app/api/deps.py) resolves to until step 3
# replaces it with real Entra ID JWT validation. Must match the id seeded
# by scripts/seed_dev_data.py.
APP_DEV_USER_ID=00000000-0000-0000-0000-000000000001
