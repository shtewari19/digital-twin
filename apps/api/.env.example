# Copy to .env and adjust as needed. Read by both docker-compose.yml
# (Postgres container credentials) and app/core/config.py (Settings).

APP_POSTGRES_USER=core_api
APP_POSTGRES_PASSWORD=dev_password
APP_POSTGRES_HOST=localhost
APP_POSTGRES_PORT=5432
APP_POSTGRES_DB=core_api

TEMPORAL_HOST=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE_STUDY_RUNS=study-runs

# Kept for seed_dev_data.py / local seed scripts only (not used by live auth).
APP_DEV_USER_ID=00000000-0000-0000-0000-000000000001

# ---------------------------------------------------------------------------
# Microsoft Entra ID — required for JWT validation (issue #16)
# ---------------------------------------------------------------------------
# Azure Portal → Microsoft Entra ID → App registrations → <your app>
APP_ENTRA_TENANT_ID=your-tenant-id-here
APP_ENTRA_CLIENT_ID=your-client-id-here

# Optional: override expected JWT `aud`. Defaults to APP_ENTRA_CLIENT_ID.
# APP_ENTRA_AUDIENCE=api://your-client-id

# Optional: scope for scripts/get_dev_token.py (do not use openid/profile — MSAL reserved).
# Local default in the script is User.Read (uses id_token for /me).
# After Expose an API:
# APP_ENTRA_SCOPE=api://your-client-id/access_as_user
